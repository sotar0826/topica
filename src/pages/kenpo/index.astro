---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { findSubject, topicOrderOf } from "../../data/curriculum";

const subject = findSubject("kenpo")!;
const order = topicOrderOf("kenpo");

const entries = await getCollection("kenpo");
const existing = new Set(entries.map((e) => e.id));
const publishedCount = order.filter((t) => existing.has(t.slug)).length;

let globalNum = 0;
---

<BaseLayout title="憲法" description={subject.description}>
  <div class="breadcrumb"><a href="/">トップ</a> › 憲法</div>

  <h1>憲法</h1>
  <p>{subject.description}</p>

  <div class="related-box">
    <span class="label">📖 学習の進め方</span>
    <p style="margin: 0.4rem 0 0; font-size: 0.9rem;">
      第1〜4編で<strong>人権</strong>（総論→精神的自由→経済的自由・社会権）、第5・6編で<strong>統治機構</strong>を扱います。
      憲法は判例を軸に学ぶ科目です。各トピックとも最高裁判例（大法廷判例を含む）を一次資料で照合したうえで、判断枠組みとあてはめを解説します。
      現在 <strong>{publishedCount} / {order.length}</strong> トピック公開中（順次追加します）。
    </p>
  </div>

  {
    subject.parts.map((part) => (
      <section class="part-section">
        <h2>第{part.number}編 {part.name}</h2>
        <ol class="topic-list">
          {part.topics.map((topic) => {
            globalNum++;
            const basicExists = existing.has(topic.slug);
            const advancedExists = existing.has(`${topic.slug}-ouyou`);
            return (
              <>
                <li>
                  <span class="num">{globalNum}.</span>
                  {basicExists ? (
                    <a href={`/kenpo/${topic.slug}/`}>{topic.title}</a>
                  ) : (
                    <span class="coming">{topic.title}</span>
                  )}
                  {!basicExists && <span class="tag-soon">準備中</span>}
                </li>
                {topic.hasAdvanced && (
                  <li class="topic-branch">
                    <span class="num">{globalNum}-1.</span>
                    {advancedExists ? (
                      <a href={`/kenpo/${topic.slug}-ouyou/`}>{topic.title}</a>
                    ) : (
                      <span class="coming">{topic.title}</span>
                    )}
                    <span class="tag-ouyou">応用編</span>
                    {!advancedExists && <span class="tag-soon">準備中</span>}
                  </li>
                )}
              </>
            );
          })}
        </ol>
      </section>
    ))
  }
</BaseLayout>
