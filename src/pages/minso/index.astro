---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { findSubject, topicOrderOf } from "../../data/curriculum";

const subject = findSubject("minso")!;
const order = topicOrderOf("minso");

const entries = await getCollection("minso");
const existing = new Set(entries.map((e) => e.id));
const publishedCount = order.filter((t) => existing.has(t.slug)).length;

let globalNum = 0;
---

<BaseLayout title="民事訴訟法" description={subject.description} image="/og/minso/index.png">
  <div class="breadcrumb"><a href="/">トップ</a> › 民事訴訟法</div>

  <h1>民事訴訟法</h1>
  <p>{subject.description}</p>

  <div class="related-box">
    <span class="label">📖 学習の進め方</span>
    <p style="margin: 0.4rem 0 0; font-size: 0.9rem;">
      訴え提起から審理・判決・上訴までの<strong>手続の時系列</strong>を背骨に、弁論主義・既判力などの基本原理を編ごとに配置しています。
      実体法（民法）の権利を裁判でどう実現するかを扱う科目なので、民法の基礎編（特に契約・不法行為）を先に読んでおくと理解が滑らかです。
      現在 <strong>{publishedCount} / {order.length}</strong> トピック公開中（順次追加します）。
    </p>
  </div>

  <div class="progress-box" data-progress data-subject="minso" data-total={publishedCount}>
    <span class="progress-label">📈 あなたの学習進捗（基礎編）</span>
    <span class="progress-count"></span>
    <div class="progress-track"><div class="progress-fill"></div></div>
  </div>

  {
    subject.parts.map((part) => (
      <section class="part-section">
        <h2>第{part.number}編 {part.name}</h2>
        <ol class="topic-list">
          {part.topics.map((topic) => {
            globalNum++;
            const basicExists = existing.has(topic.slug);
            const advancedExists = existing.has(`${topic.slug}-ouyou`);
            return (
              <>
                <li data-read-slug={basicExists ? `minso/${topic.slug}` : undefined}>
                  <span class="num">{globalNum}.</span>
                  {basicExists ? (
                    <a href={`/minso/${topic.slug}/`}>{topic.title}</a>
                  ) : (
                    <span class="coming">{topic.title}</span>
                  )}
                  {!basicExists && <span class="tag-soon">準備中</span>}
                </li>
                {topic.hasAdvanced && (
                  <li class="topic-branch" data-read-slug={advancedExists ? `minso/${topic.slug}-ouyou` : undefined}>
                    <span class="num">{globalNum}-1.</span>
                    {advancedExists ? (
                      <a href={`/minso/${topic.slug}-ouyou/`}>{topic.title}</a>
                    ) : (
                      <span class="coming">{topic.title}</span>
                    )}
                    <span class="tag-ouyou">応用編</span>
                    {!advancedExists && <span class="tag-soon">準備中</span>}
                  </li>
                )}
              </>
            );
          })}
        </ol>
      </section>
    ))
  }
  <p class="progress-reset-row">
    <button type="button" class="progress-reset" data-reset-subject="minso" data-reset-label="民事訴訟法">
      民事訴訟法の読了記録をリセット
    </button>
  </p>
</BaseLayout>
