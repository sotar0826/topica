---
import { getCollection } from "astro:content";
import YohakuLayout from "../../layouts/YohakuLayout.astro";
import { YOHAKU_BASE, YOHAKU_SITE_NAME, YOHAKU_CATEGORIES, findYohakuCategory, readingMinutes } from "../../data/yohaku";

const entries = (await getCollection("yohaku")).sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const ymd = (d: Date) => d.toISOString().slice(0, 10);
---

<YohakuLayout
  title={YOHAKU_SITE_NAME}
  description="前から気になっていたけれど、ちゃんと調べたことのなかった問いを一つずつ取り上げ、通説と論争、仕組みと歴史まで掘り下げて書く読みもののノート。"
>
  <p class="y-intro">
    前から気になっていたけれど、ちゃんと調べたことのなかった問いを、一つずつ腰を据えて調べて書くノートです。
    要点だけを並べるのではなく、「なぜそう言えるのか」「どこで意見が分かれているのか」まで追いかけます。
    一本あたり、ゆっくり読んで二、三十分の分量です。
  </p>

  <h2 class="y-section-title">新しい順</h2>
  <ul class="y-list">
    {
      entries.map((e) => {
        const cat = findYohakuCategory(e.data.category);
        return (
          <li>
            <a class="t" href={`${YOHAKU_BASE}/${e.id}/`}>{e.data.title}</a>
            {e.data.question && <p class="q">{e.data.question}</p>}
            <p class="d">{e.data.description}</p>
            <span class="y-meta">
              {cat && <a href={`${YOHAKU_BASE}/category/${cat.slug}/`}>{cat.name}</a>} ・ <time datetime={ymd(e.data.published)}>{ymd(e.data.published)}</time> ・ 約{readingMinutes(e.body ?? "")}分
            </span>
          </li>
        );
      })
    }
  </ul>

  <h2 class="y-section-title">カテゴリ</h2>
  <ul class="y-list">
    {
      YOHAKU_CATEGORIES.map((c) => {
        const n = entries.filter((e) => e.data.category === c.slug).length;
        return (
          <li>
            <a class="t" href={`${YOHAKU_BASE}/category/${c.slug}/`}>{c.name}</a>
            <p class="d">{c.description}（{n}本）</p>
          </li>
        );
      })
    }
  </ul>
</YohakuLayout>
