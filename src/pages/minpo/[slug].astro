---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { findTopic, prevNext, TOPIC_ORDER } from "../../data/curriculum";

export async function getStaticPaths() {
  const entries = await getCollection("minpo");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const isAdvanced = entry.data.level === "advanced";
const baseSlug = entry.id.replace(/-ouyou$/, "");
const topicInfo = findTopic(baseSlug);
const nav = prevNext(baseSlug);

// 応用編が存在するかどうか（基礎編ページに応用編リンクを出す用）
const allEntries = await getCollection("minpo");
const existingIds = new Set(allEntries.map((e) => e.id));
const advancedExists = existingIds.has(`${baseSlug}-ouyou`);

// 関連ページ（前提知識）のリンク解決
const relatedLinks = entry.data.related
  .map((slug) => {
    const t = TOPIC_ORDER.find((x) => x.slug === slug);
    return t ? { slug, title: t.title, exists: existingIds.has(slug) } : null;
  })
  .filter((x) => x !== null);

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? "https://topica.pages.dev").href;
const aiTemplate = `以下の法律学習ページの内容について質問があります。\nページ：${entry.data.title}（${isAdvanced ? "応用編" : "基礎編"}）\nURL：${pageUrl}\n\nこのページの内容について、理解度を確認するテストを作ってください。`;
---

<BaseLayout title={`${entry.data.title}${isAdvanced ? "（応用編）" : ""}`} description={entry.data.description}>
  <div class="breadcrumb">
    <a href="/">トップ</a> › <a href="/minpo/">民法</a>
    {topicInfo && ` › 第${topicInfo.partNumber}編 ${topicInfo.partName}`}
  </div>

  <div class="topic-header">
    <span class={`level-badge${isAdvanced ? " advanced" : ""}`}>
      {isAdvanced ? "応用編（予備試験レベル）" : "基礎編"}
    </span>
    <h1>{entry.data.title}</h1>
  </div>

  {
    (relatedLinks.length > 0 || (isAdvanced && existingIds.has(baseSlug))) && (
      <div class="related-box">
        <span class="label">📚 先に読んでおきたいページ</span>
        <ul>
          {isAdvanced && existingIds.has(baseSlug) && (
            <li>
              <a href={`/minpo/${baseSlug}/`}>{topicInfo?.title}（基礎編）</a> — このページの前提です
            </li>
          )}
          {relatedLinks.map((r) => (
            <li>{r.exists ? <a href={`/minpo/${r.slug}/`}>{r.title}</a> : `${r.title}（準備中）`}</li>
          ))}
        </ul>
      </div>
    )
  }

  <article class="topic-body">
    <Content />
  </article>

  {
    !isAdvanced && advancedExists && (
      <div class="related-box">
        <span class="label">🚀 さらに学ぶ</span>
        <ul>
          <li>
            <a href={`/minpo/${baseSlug}-ouyou/`}>{entry.data.title}（応用編）</a> — 判例・学説・論述対策へ
          </li>
        </ul>
      </div>
    )
  }

  <section class="ask-ai">
    <h2>🤖 このページについてAIに質問する</h2>
    <p>
      わからないことがあれば、下のテンプレートをコピーして
      <a href="https://claude.ai" target="_blank" rel="noopener">Claude</a>
      などのAIに貼り付けて質問できます。テストを作ってもらうのもおすすめです。
    </p>
    <textarea id="ai-template" rows="5" readonly>{aiTemplate}</textarea>
    <button id="copy-btn" type="button">テンプレートをコピー</button>
  </section>

  <nav class="topic-nav">
    {
      nav.prev ? (
        <a href={`/minpo/${nav.prev.slug}/`} class="prev">
          <span class="dir">← 前のトピック</span>
          <br />
          {nav.prev.title}
        </a>
      ) : (
        <span />
      )
    }
    {
      nav.next ? (
        <a href={`/minpo/${nav.next.slug}/`} class="next">
          <span class="dir">次のトピック →</span>
          <br />
          {nav.next.title}
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</BaseLayout>

<script>
  const btn = document.getElementById("copy-btn");
  const ta = document.getElementById("ai-template") as HTMLTextAreaElement | null;
  btn?.addEventListener("click", async () => {
    if (!ta) return;
    await navigator.clipboard.writeText(ta.value);
    btn.textContent = "コピーしました ✓";
    setTimeout(() => (btn.textContent = "テンプレートをコピー"), 2000);
  });
</script>
