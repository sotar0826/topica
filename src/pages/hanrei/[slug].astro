---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { findSubject, topicOrderOf } from "../../data/curriculum";
import { articleLd, breadcrumbLd, abs, ymd } from "../../lib/jsonld";
import { INDEXABLE_HANREI_SET } from "../../data/quality-gates.mjs";
import { selectRelatedHanrei } from "../../lib/related-hanrei.mjs";

export async function getStaticPaths() {
  const entries = await getCollection("hanrei");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// 判決全文ページ（/hanrei/<slug>/zenbun/）があればそこへ、なければ courtsId があれば
// 裁判所ウェブサイト（裁判例検索）の詳細ページへリンクする。
const zenbunEntry = await getEntry("zenbun", entry.id);
const courtsDetailUrl = entry.data.courtsId
  ? `https://www.courts.go.jp/hanrei/${entry.data.courtsId}/detail2/index.html`
  : null;
const showCourtsFallback = !zenbunEntry && courtsDetailUrl;

const subject = findSubject(entry.data.subject);

// 同じ科目の他の判例解説（回遊導線）。一覧ページと同じ判決日昇順で並べ、
// 現在のページに近い判例から見つけやすいよう当該判例の前後を中心に最大5件を抜き出す
const sameSubjectEntries = (await getCollection("hanrei"))
  .filter((e) => e.data.subject === entry.data.subject && INDEXABLE_HANREI_SET.has(e.id))
  .sort((a, b) => a.data.dateISO.valueOf() - b.data.dateISO.valueOf());
const relatedHanrei = selectRelatedHanrei(sameSubjectEntries, entry.id, 5);

// 関連トピックのリンク解決（"keiso/kyosei-shobun" 形式 → タイトル）
const topicLinks = entry.data.topics
  .map((t) => {
    const [sub, slug] = t.split("/");
    const base = slug.replace(/-ouyou$/, "");
    const info = topicOrderOf(sub).find((x) => x.slug === base);
    const subName = findSubject(sub)?.name ?? sub;
    return info
      ? { href: `/${sub}/${slug}/`, label: `${subName}：${info.title}` }
      : null;
  })
  .filter((x) => x !== null);

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? "https://topica-law.com").href;
const headline = `${entry.data.title}（${entry.data.court}${entry.data.decisionDate}）`;
const isIndexable = INDEXABLE_HANREI_SET.has(entry.id);

const jsonLd = [
  articleLd({
    title: headline,
    description: entry.data.description,
    url: pageUrl,
    published: entry.data.published,
    updated: entry.data.updated,
  }),
  breadcrumbLd([
    { name: "トップ", url: abs("/") },
    { name: "判例解説", url: abs("/hanrei/") },
    { name: entry.data.title, url: pageUrl },
  ]),
];
---

<BaseLayout
  title={entry.data.seoTitle ?? headline}
  description={entry.data.description}
  ogType="article"
  image={`/og/hanrei/${entry.id}.png`}
  jsonLd={jsonLd}
  noindex={!isIndexable}
>
  <div class="breadcrumb">
    <a href="/">トップ</a> › <a href="/hanrei/">判例解説</a>
    {subject && ` › ${subject.name}`}
  </div>

  <div class="topic-header">
    <span class="level-badge">判例解説</span>
    <h1>{entry.data.title}</h1>
  </div>

  <div class="toc-container" data-toc></div>

  <table>
    <tbody>
      <tr><th style="white-space: nowrap;">裁判所</th><td>{entry.data.court}</td></tr>
      <tr><th style="white-space: nowrap;">裁判年月日</th><td>{entry.data.decisionDate}</td></tr>
      <tr><th style="white-space: nowrap;">出典</th><td>{entry.data.citation}</td></tr>
      {
        entry.data.caseNumber && (
          <tr><th style="white-space: nowrap;">事件番号</th><td>{entry.data.caseNumber}</td></tr>
        )
      }
      {
        entry.data.articles.length > 0 && (
          <tr><th style="white-space: nowrap;">関連条文</th><td>{entry.data.articles.join("・")}</td></tr>
        )
      }
    </tbody>
  </table>

  {
    zenbunEntry && (
      <a href={`/hanrei/${entry.id}/zenbun/`} class="zenbun-link">📄 判決全文を読む</a>
    )
  }
  {
    showCourtsFallback && (
      <a href={courtsDetailUrl} target="_blank" rel="noopener noreferrer" class="zenbun-link">
        📄 判決全文（裁判所ウェブサイト）
      </a>
    )
  }

  <article class="topic-body" data-pagefind-body={isIndexable ? "" : undefined}>
    <Content />
  </article>

  {
    (entry.data.updated || true) && (
      <p class="page-meta">
        {entry.data.updated && (
          <span>
            最終更新: <time datetime={ymd(entry.data.updated)}>{ymd(entry.data.updated)}</time>
          </span>
        )}
      </p>
    )
  }

  {
    topicLinks.length > 0 && (
      <div class="related-box">
        <span class="label">📚 この判例を扱っているトピック</span>
        <ul>
          {topicLinks.map((t) => (
            <li>
              <a href={t.href}>{t.label}</a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    relatedHanrei.length > 0 && (
      <div class="related-box">
        <span class="label">⚖️ {subject ? `${subject.name}の` : ""}他の判例解説</span>
        <ul>
          {relatedHanrei.map((e) => (
            <li>
              <a href={`/hanrei/${e.id}/`}>
                {e.data.title}（{e.data.court}{e.data.decisionDate}）
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <nav class="topic-nav">
    <a href="/hanrei/" class="prev">
      <span class="dir">← 判例解説一覧へ</span>
    </a>
    <span />
  </nav>
</BaseLayout>

<style>
  .zenbun-link {
    display: inline-block;
    margin: 0.8rem 0 0.4rem;
    padding: 0.5rem 1rem;
    background: var(--accent-light);
    color: var(--accent-dark);
    border: 1px solid var(--accent);
    border-radius: 6px;
    font-weight: bold;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .zenbun-link:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
</style>
