---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { PUBLIC_SUBJECTS, topicOrderOf } from "../data/curriculum";
import { INDEXABLE_HANREI_SET } from "../data/quality-gates.mjs";
import { abs, ymd } from "../lib/jsonld";
import { collectRecentItems } from "../lib/recent";

// 学習進捗サマリー用：科目ごとの公開済み基礎編トピック数
const progressRows = await Promise.all(
  PUBLIC_SUBJECTS.map(async (subject) => {
    const entries = await getCollection(subject.slug as "minpo");
    const existing = new Set(entries.map((e) => e.id));
    const total = topicOrderOf(subject.slug).filter((t) => existing.has(t.slug)).length;
    return { slug: subject.slug, name: subject.name, total, articleCount: entries.length };
  })
);
const topicArticleCount = progressRows.reduce((sum, row) => sum + row.articleCount, 0);

// 新着・更新セクション用：rss.xml と同じ集め方（全公開科目＋判例解説＋コラム）から最新10件
const recentItems = (await collectRecentItems()).slice(0, 10);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "トピカ",
  alternateName: "トピカ｜法律学習サイト",
  url: abs("/"),
  description: "法律を体系的に学べるオンライン学習サイト。基礎から応用まで、1トピック1ページで解説します。",
  inLanguage: "ja",
  publisher: {
    "@type": "Organization",
    name: "トピカ",
    url: abs("/"),
    logo: { "@type": "ImageObject", url: abs("/ogp-default.png") },
  },
};
---

<BaseLayout title="トピカ" jsonLd={jsonLd}>
  <div class="hero">
    <h1>トピカ</h1>
    <p>1トピック1ページで学ぶ、法律の学習サイト。</p>
    <p>
      法律をはじめて学ぶ人でも読める「基礎編」から、<br />
      判例・学説まで踏み込む「応用編」へ、段階的にステップアップ。
    </p>
  </div>

  <nav class="site-stats" aria-label="収録内容">
    <a href="#subjects">
      <strong>{PUBLIC_SUBJECTS.length}科目</strong>
      <span>体系別カリキュラム</span>
    </a>
    <a href="#subjects">
      <strong>{topicArticleCount}本</strong>
      <span>基礎・応用の記事</span>
    </a>
    <a href="/hanrei/">
      <strong>{INDEXABLE_HANREI_SET.size}件</strong>
      <span>詳しい判例解説</span>
    </a>
  </nav>

  <section aria-labelledby="start-heading" class="start-section">
    <h2 id="start-heading">目的から探す</h2>
    <div class="start-grid">
      <a href="/minpo/zentaizo/" class="start-card">
        <span class="start-label">はじめて学ぶ</span>
        <strong>まず法律の全体像をつかむ</strong>
        <span>身近な民法を入口に、基本用語と考え方を順番に学びます。</span>
      </a>
      <a href="#subjects" class="start-card">
        <span class="start-label">科目から学ぶ</span>
        <strong>体系に沿って読み進める</strong>
        <span>基礎編から応用編へ、前提知識を確認しながら進めます。</span>
      </a>
      <a href="/hanrei/" class="start-card">
        <span class="start-label">判例から学ぶ</span>
        <strong>事案・判旨・射程を深く読む</strong>
        <span>重要判例を、結論だけでなく判断の位置づけまで整理しています。</span>
      </a>
      <a href="/quiz/" class="start-card">
        <span class="start-label">理解を確かめる</span>
        <strong>一問一答に取り組む</strong>
        <span>各記事の確認問題から出題し、解説と元の記事へ戻れます。</span>
      </a>
    </div>
  </section>

  <section aria-labelledby="guide-heading" class="home-guides">
    <h2 id="guide-heading">学び方に迷ったら</h2>
    <div class="guide-grid">
      <article class="guide-card">
        <span class="start-label">初学者向け</span>
        <a href="/column/law-study-guide/">法律の勉強法</a>
        <p>理解・想起・再確認を一つの学習サイクルにして、迷わず始める手順を案内します。</p>
      </article>
      <article class="guide-card">
        <span class="start-label">判例学習</span>
        <a href="/column/hanrei-reading-guide/">判例の読み方</a>
        <p>事案、争点、規範、当てはめ、射程を混同せずに読む5段階を整理します。</p>
      </article>
      <article class="guide-card">
        <span class="start-label">科目別</span>
        <a href="/column/gyosei-study-guide/">行政法の勉強法</a>
        <p>行政作用から行政救済へ進む順序と、33記事を使った復習ルートを示します。</p>
      </article>
      <article class="guide-card">
        <span class="start-label">アウトプット</span>
        <a href="/column/law-answer-writing-guide/">法律答案の書き方</a>
        <p>問い、条文、規範、当てはめ、結論を一つの理由としてつなぐ手順を案内します。</p>
      </article>
    </div>
    <p class="section-more"><a href="/column/">学習ガイド・コラムをすべて見る →</a></p>
  </section>

  <h2 id="subjects" style="font-size: 1.2rem; scroll-margin-top: 6rem;">科目一覧</h2>
  {
    PUBLIC_SUBJECTS.map((subject) => (
      <a href={`/${subject.slug}/`} class="subject-card">
        <h2>{subject.name}</h2>
        <p>{subject.description}</p>
        <p style="margin-top: 0.5rem;">全{topicOrderOf(subject.slug).length}トピック →</p>
      </a>
    ))
  }
  <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 1rem;">
    7科目の基礎編をすべて収録し、重要論点には応用編も用意しています。
  </p>

  <section aria-labelledby="recent-heading">
    <h2 id="recent-heading" style="font-size: 1.2rem; margin-top: 2.5rem;">新着・更新</h2>
    <ul class="recent-list">
      {
        recentItems.map((item) => (
          <li>
            <a href={item.path}>{item.title}</a>
            <span class="recent-meta">
              <span class="recent-category">{item.category}</span>
              <time datetime={ymd(item.date)}>{ymd(item.date)}</time>
            </span>
          </li>
        ))
      }
    </ul>
    <p style="font-size: 0.8rem; margin-top: 0.5rem;">
      <a href="/rss.xml">📡 更新をRSSで受け取る →</a>
    </p>
  </section>

  {/* 学習進捗サマリー（読了記録があるときだけ progress.js が表示する） */}
  <section id="progress-summary" hidden>
    <h2 style="font-size: 1.2rem; margin-top: 2.5rem;">あなたの学習進捗</h2>
    {
      progressRows.map((row) => (
        <div
          class="progress-box"
          data-progress
          data-subject={row.slug}
          data-total={row.total}
          data-hide-empty="1"
          hidden
        >
          <span class="progress-label">{row.name}</span>
          <span class="progress-count" />
          <div class="progress-track">
            <div class="progress-fill" />
          </div>
        </div>
      ))
    }
    <p style="font-size: 0.8rem; color: var(--text-muted);">
      読了記録はこの端末のブラウザにのみ保存されます。
    </p>
  </section>

  <h2 style="font-size: 1.2rem; margin-top: 2.5rem;">このサイトの使い方</h2>
  <ul style="font-size: 0.95rem;">
    <li><strong>基礎編</strong>：専門用語をかみくだいた解説と日常的な具体例で、ゼロから理解できます。</li>
    <li><strong>応用編</strong>：重要判例・学説の対立から論述の書き方まで、一歩踏み込んで解説します。</li>
    <li><strong>確認問題</strong>：各ページ末尾の○×問題で理解度をチェックできます。</li>
  </ul>
  <p style="margin-top: 0.5rem;">
    <a href="/quiz/">🎯 一問一答で確認する →</a>
  </p>
  <p class="about-link">
    記事の構成や収録内容については、<a href="/about/">このサイトについて</a>をご覧ください。
  </p>
</BaseLayout>
