---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { PUBLIC_SUBJECTS, topicOrderOf } from "../data/curriculum";
import { abs } from "../lib/jsonld";

// 学習進捗サマリー用：科目ごとの公開済み基礎編トピック数
const progressRows = await Promise.all(
  PUBLIC_SUBJECTS.map(async (subject) => {
    const entries = await getCollection(subject.slug as "minpo");
    const existing = new Set(entries.map((e) => e.id));
    const total = topicOrderOf(subject.slug).filter((t) => existing.has(t.slug)).length;
    return { slug: subject.slug, name: subject.name, total };
  })
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "トピカ",
  alternateName: "トピカ｜法律学習サイト",
  url: abs("/"),
  description: "法律を体系的に学べるオンライン学習サイト。基礎から応用まで、1トピック1ページで解説します。",
  inLanguage: "ja",
  publisher: {
    "@type": "Organization",
    name: "トピカ",
    url: abs("/"),
    logo: { "@type": "ImageObject", url: abs("/ogp-default.png") },
  },
};
---

<BaseLayout title="トピカ" jsonLd={jsonLd}>
  <div class="hero">
    <h1>トピカ</h1>
    <p>1トピック1ページで学ぶ、法律の学習サイト。</p>
    <p>
      法律をはじめて学ぶ人でも読める「基礎編」から、<br />
      判例・学説まで踏み込む「応用編」へ、段階的にステップアップ。
    </p>
  </div>

  <h2 style="font-size: 1.2rem;">科目一覧</h2>
  {
    PUBLIC_SUBJECTS.map((subject) => (
      <a href={`/${subject.slug}/`} class="subject-card">
        <h2>{subject.name}</h2>
        <p>{subject.description}</p>
        <p style="margin-top: 0.5rem;">全{topicOrderOf(subject.slug).length}トピック →</p>
      </a>
    ))
  }
  <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 1rem;">
    ※ 科目は今後、順次追加予定です。
  </p>

  {/* 学習進捗サマリー（読了記録があるときだけ progress.js が表示する） */}
  <section id="progress-summary" hidden>
    <h2 style="font-size: 1.2rem; margin-top: 2.5rem;">あなたの学習進捗</h2>
    {
      progressRows.map((row) => (
        <div
          class="progress-box"
          data-progress
          data-subject={row.slug}
          data-total={row.total}
          data-hide-empty="1"
          hidden
        >
          <span class="progress-label">{row.name}</span>
          <span class="progress-count" />
          <div class="progress-track">
            <div class="progress-fill" />
          </div>
        </div>
      ))
    }
    <p style="font-size: 0.8rem; color: var(--text-muted);">
      読了記録はこの端末のブラウザにのみ保存されます。
    </p>
  </section>

  <h2 style="font-size: 1.2rem; margin-top: 2.5rem;">このサイトの使い方</h2>
  <ul style="font-size: 0.95rem;">
    <li><strong>基礎編</strong>：専門用語をかみくだいた解説と日常的な具体例で、ゼロから理解できます。</li>
    <li><strong>応用編</strong>：重要判例・学説の対立から論述の書き方まで、一歩踏み込んで解説します。</li>
    <li><strong>確認問題</strong>：各ページ末尾の○×問題で理解度をチェックできます。</li>
  </ul>
  <p style="margin-top: 0.5rem;">
    <a href="/quiz/">🎯 一問一答で確認する →</a>
  </p>
</BaseLayout>
