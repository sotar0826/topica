---
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbLd, abs } from "../lib/jsonld";

// 用語集。term = 用語 / reading = 読み / def = 定義 / topic = 詳しく学べるトピックのスラッグ（任意）
interface Term {
  term: string;
  reading?: string;
  def: string;
  topic?: { slug: string; title: string };
}

const TERMS: Term[] = [
  {
    term: "意思表示",
    reading: "いしひょうじ",
    def: "一定の法律効果の発生を欲する意思を外部に表示する行為。契約の申込み・承諾がその典型で、法律行為のもっとも基本的な要素。",
    topic: { slug: "shinri-ryuho", title: "意思表示総論・心裡留保" },
  },
  {
    term: "法律行為",
    reading: "ほうりつこうい",
    def: "意思表示を要素とし、表示されたとおりの法律効果を生じさせる行為。契約・遺言・取消しなどが含まれる。",
    topic: { slug: "zentaizo", title: "民法の全体像と学び方" },
  },
  {
    term: "善意・悪意",
    reading: "ぜんい・あくい",
    def: "ある事実を知らないことを善意、知っていることを悪意という。日常用語と異なり、道徳的な善し悪しの意味はない。",
  },
  {
    term: "過失・無過失",
    reading: "かしつ・むかしつ",
    def: "取引上要求される注意を怠ったことが過失、注意を尽くしてもなお知り得なかったことが無過失。著しい不注意は重過失と呼ばれ、悪意と同様に扱われる場面が多い。",
  },
  {
    term: "第三者",
    reading: "だいさんしゃ",
    def: "法律行為の当事者とその包括承継人（相続人など）以外の者。条文ごとに「第三者」として保護されるための要件（善意・無過失・登記など）が異なる点が重要。",
    topic: { slug: "kyogi-hyoji", title: "虚偽表示" },
  },
  {
    term: "対抗要件",
    reading: "たいこうようけん",
    def: "すでに生じた権利変動を第三者に主張（対抗）するために必要とされる要件。不動産は登記（177条）、動産は引渡し（178条）、債権譲渡は通知または承諾（467条）。",
    topic: { slug: "fudosan-bukken-hendo", title: "不動産物権変動（177条）" },
  },
  {
    term: "無効と取消し",
    reading: "むこうととりけし",
    def: "無効は初めから効力が生じないこと。取消しは、取り消すまでは有効で、取り消されると遡って無効になること。誰が・いつまで主張できるかも異なる。",
    topic: { slug: "muko-torikeshi", title: "無効と取消し" },
  },
  {
    term: "追認",
    reading: "ついにん",
    def: "取り消しうる行為や無権代理行為を、後から確定的に有効とする意思表示。追認すると以後は取り消せなくなる。",
  },
  {
    term: "時効",
    reading: "じこう",
    def: "一定期間の経過を理由に、権利の取得（取得時効）または消滅（消滅時効）という効果を生じさせる制度。効果の発生には当事者の援用が必要（145条）。",
    topic: { slug: "shometsu-jiko", title: "消滅時効" },
  },
  {
    term: "債権・債務",
    reading: "さいけん・さいむ",
    def: "特定の人（債務者）に対して一定の行為（給付）を請求できる権利が債権、その裏返しとして給付をすべき義務が債務。",
  },
  {
    term: "物権",
    reading: "ぶっけん",
    def: "物を直接支配して利益を受ける権利。所有権・抵当権などがあり、誰に対しても主張できる。種類・内容は法律で定められたものに限られる（物権法定主義・175条）。",
    topic: { slug: "bukken-soron", title: "物権総論・物権変動の基礎" },
  },
  {
    term: "登記",
    reading: "とうき",
    def: "不動産の権利関係を法務局の登記簿に記録して公示する制度。不動産物権変動の対抗要件となる（177条）。",
    topic: { slug: "fudosan-bukken-hendo", title: "不動産物権変動（177条）" },
  },
  {
    term: "弁済",
    reading: "べんさい",
    def: "債務の内容どおりの給付をして債権を消滅させること。日常用語の「返済」より広く、売主が商品を引き渡すことも弁済にあたる。",
    topic: { slug: "bensai", title: "弁済" },
  },
  {
    term: "相殺",
    reading: "そうさい",
    def: "互いに同種の債権を持ち合う当事者の一方が、対当額で双方の債権を消滅させる一方的意思表示（505条）。簡易な決済と担保の機能を持つ。",
    topic: { slug: "sosai", title: "相殺" },
  },
  {
    term: "解除",
    reading: "かいじょ",
    def: "契約の一方当事者の意思表示によって契約関係を解消すること。債務不履行を理由とする法定解除（541条・542条）が典型。",
    topic: { slug: "kaijo", title: "解除" },
  },
  {
    term: "損害賠償",
    reading: "そんがいばいしょう",
    def: "債務不履行（415条）や不法行為（709条）によって生じた損害を、金銭の支払いにより填補させること。",
  },
  {
    term: "不法行為",
    reading: "ふほうこうい",
    def: "故意または過失によって他人の権利・法律上保護される利益を侵害し、損害を生じさせる行為（709条）。契約関係がない当事者間でも損害賠償請求権を発生させる。",
    topic: { slug: "fuho-koi-kiso", title: "不法行為の基礎" },
  },
  {
    term: "抵当権",
    reading: "ていとうけん",
    def: "目的不動産の占有を設定者のもとに残したまま設定し、債務が履行されないときに目的物の価値から優先的に弁済を受けられる担保物権（369条）。",
    topic: { slug: "teito-ken", title: "抵当権（基礎）" },
  },
  {
    term: "保証",
    reading: "ほしょう",
    def: "主たる債務者が債務を履行しないときに、代わって履行する義務を負う契約（446条）。債権者と保証人との間の契約であり、書面が必要。",
    topic: { slug: "hosho", title: "保証" },
  },
  {
    term: "援用",
    reading: "えんよう",
    def: "時効などの利益を受ける旨を主張すること。時効は期間が経過しただけでは効果が確定せず、当事者の援用があって初めて裁判所がこれを認められる（145条）。",
    topic: { slug: "shometsu-jiko", title: "消滅時効" },
  },
];

const jsonLd = breadcrumbLd([
  { name: "トップ", url: abs("/") },
  { name: "用語集", url: abs("/yougo/") },
]);
---

<BaseLayout
  title="法律用語集"
  description="民法学習でつまずきやすい基本用語を、初学者向けに短く正確に解説します。各用語から詳しく学べるトピックへリンクしています。"
  jsonLd={jsonLd}
>
  <div class="breadcrumb"><a href="/">トップ</a> › 用語集</div>

  <h1>法律用語集</h1>
  <p>
    法律の条文や解説には、日常用語と意味の異なる専門用語が多く登場します。
    ここでは学習の前提となる基本用語を短くまとめました。詳しくは各用語のリンク先トピックをご覧ください。
  </p>

  <dl class="glossary">
    {
      TERMS.map((t) => (
        <div class="glossary-item">
          <dt id={t.term}>
            {t.term}
            {t.reading && <span class="reading">（{t.reading}）</span>}
          </dt>
          <dd>
            {t.def}
            {t.topic && (
              <span class="glossary-link">
                → <a href={`/minpo/${t.topic.slug}/`}>{t.topic.title}</a>
              </span>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</BaseLayout>
