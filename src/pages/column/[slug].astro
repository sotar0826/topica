---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TOPIC_ORDER } from "../../data/curriculum";
import { articleLd, breadcrumbLd, abs, ymd } from "../../lib/jsonld";

export async function getStaticPaths() {
  const entries = await getCollection("column");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const minpoEntries = await getCollection("minpo");
const existingIds = new Set(minpoEntries.map((e) => e.id));

const relatedLinks = entry.data.related
  .map((slug) => {
    const t = TOPIC_ORDER.find((x) => x.slug === slug);
    return t ? { slug, title: t.title, exists: existingIds.has(slug) } : null;
  })
  .filter((x) => x !== null);

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? "https://topica.pages.dev").href;
const aiTemplate = `以下の法律学習コラムの内容について質問があります。\nコラム：${entry.data.title}\nURL：${pageUrl}\n\nこのコラムの内容について、理解度を確認するテストを作ってください。`;

const jsonLd = [
  articleLd({
    title: entry.data.title,
    description: entry.data.description,
    url: pageUrl,
    published: entry.data.published,
    updated: entry.data.updated,
  }),
  breadcrumbLd([
    { name: "トップ", url: abs("/") },
    { name: "コラム", url: abs("/column/") },
    { name: entry.data.title, url: pageUrl },
  ]),
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="breadcrumb">
    <a href="/">トップ</a> › <a href="/column/">コラム</a>
  </div>

  <div class="topic-header">
    <span class="level-badge advanced">コラム（司法試験レベル）</span>
    <h1>{entry.data.title}</h1>
  </div>

  {
    relatedLinks.length > 0 && (
      <div class="related-box">
        <span class="label">📚 関連トピック</span>
        <ul>
          {relatedLinks.map((r) => (
            <li>{r.exists ? <a href={`/minpo/${r.slug}/`}>{r.title}</a> : `${r.title}（準備中）`}</li>
          ))}
        </ul>
      </div>
    )
  }

  <article class="topic-body">
    <Content />
  </article>

  {
    entry.data.updated && (
      <p class="page-meta">
        最終更新: <time datetime={ymd(entry.data.updated)}>{ymd(entry.data.updated)}</time>
      </p>
    )
  }

  <section class="ask-ai">
    <h2>🤖 このコラムについてAIに質問する</h2>
    <p>
      わからないことがあれば、下のテンプレートをコピーして
      <a href="https://claude.ai" target="_blank" rel="noopener">Claude</a>
      などのAIに貼り付けて質問できます。
    </p>
    <textarea id="ai-template" rows="5" readonly>{aiTemplate}</textarea>
    <button id="copy-btn" type="button">テンプレートをコピー</button>
  </section>
</BaseLayout>

<script>
  const btn = document.getElementById("copy-btn");
  const ta = document.getElementById("ai-template") as HTMLTextAreaElement | null;
  btn?.addEventListener("click", async () => {
    if (!ta) return;
    await navigator.clipboard.writeText(ta.value);
    btn.textContent = "コピーしました ✓";
    setTimeout(() => (btn.textContent = "テンプレートをコピー"), 2000);
  });
</script>
