---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TOPIC_ORDER } from "../../data/curriculum";
import { articleLd, breadcrumbLd, abs, ymd } from "../../lib/jsonld";

export async function getStaticPaths() {
  const entries = await getCollection("column");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const minpoEntries = await getCollection("minpo");
const existingIds = new Set(minpoEntries.map((e) => e.id));

const relatedLinks = entry.data.related
  .map((slug) => {
    const t = TOPIC_ORDER.find((x) => x.slug === slug);
    return t ? { slug, title: t.title, exists: existingIds.has(slug) } : null;
  })
  .filter((x) => x !== null);

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? "https://topica-law.com").href;

const jsonLd = [
  articleLd({
    title: entry.data.title,
    description: entry.data.description,
    url: pageUrl,
    published: entry.data.published,
    updated: entry.data.updated,
  }),
  breadcrumbLd([
    { name: "トップ", url: abs("/") },
    { name: "コラム", url: abs("/column/") },
    { name: entry.data.title, url: pageUrl },
  ]),
];
---

<BaseLayout
  title={entry.data.seoTitle ?? entry.data.title}
  description={entry.data.description}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="breadcrumb">
    <a href="/">トップ</a> › <a href="/column/">コラム</a>
  </div>

  <div class="topic-header">
    <span class="level-badge advanced">コラム（発展）</span>
    <h1>{entry.data.title}</h1>
  </div>

  {
    relatedLinks.length > 0 && (
      <div class="related-box">
        <span class="label">📚 関連トピック</span>
        <ul>
          {relatedLinks.map((r) => (
            <li>{r.exists ? <a href={`/minpo/${r.slug}/`}>{r.title}</a> : `${r.title}（準備中）`}</li>
          ))}
        </ul>
      </div>
    )
  }

  <article class="topic-body" data-pagefind-body>
    <Content />
  </article>

  {
    entry.data.updated && (
      <p class="page-meta">
        最終更新: <time datetime={ymd(entry.data.updated)}>{ymd(entry.data.updated)}</time>
      </p>
    )
  }

</BaseLayout>
