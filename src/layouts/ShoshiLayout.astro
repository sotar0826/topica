---
// 行政書士サイト（/gyoseishoshi/ 以下）専用のレイアウト。
// トピカ本体とは別サイトとして見せるため、ヘッダー・フッターにトピカへのリンクを置かない。
// 見た目の部品（global.css・nav.js のダークモード/ドロワー）はトピカと共有する。
import "../styles/global.css";
import { SHOSHI_BASE, SHOSHI_INDEXABLE, SHOSHI_SITE_NAME, SHOSHI_SUBJECTS } from "../data/gyoseishoshi";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title === SHOSHI_SITE_NAME ? SHOSHI_SITE_NAME : `${title}｜${SHOSHI_SITE_NAME}`;

const site = Astro.site ?? new URL("https://topica-law.com");
const canonical = new URL(Astro.url.pathname, site).href;

// トピカと同じドメインなので Web Analytics のトークンも共通。
const CF_ANALYTICS_TOKEN = "c7cd2df2924841e28234f03cdd033f9e";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // ダークモードの先行適用（BaseLayout と同じ処理）
      document.documentElement.classList.add("has-js");
      (function () {
        try {
          var stored = localStorage.getItem("topica:theme");
          var theme =
            stored === "dark" || stored === "light"
              ? stored
              : window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {!SHOSHI_INDEXABLE && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SHOSHI_SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    {
      CF_ANALYTICS_TOKEN && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <div class="inner">
        <a href={`${SHOSHI_BASE}/`} class="site-logo">{SHOSHI_SITE_NAME}<span>行政書士試験の学習サイト</span></a>
        <div class="header-right">
          <nav class="header-nav" id="header-nav">
            <div class="nav-group nav-subjects">
              {SHOSHI_SUBJECTS.map((s) => <a href={`${SHOSHI_BASE}/${s.slug}/`}>{s.name}</a>)}
            </div>
            <div class="nav-divider" aria-hidden="true"></div>
            <div class="nav-group nav-content">
              <a href={`${SHOSHI_BASE}/shiken-annai/`}>試験案内</a>
              <a href={`${SHOSHI_BASE}/mogi/`}>模擬試験</a>
            </div>
          </nav>
          <button id="theme-toggle" type="button" class="icon-btn theme-toggle" aria-label="ダークモードに切り替える">
            🌙
          </button>
          <button
            id="nav-toggle"
            type="button"
            class="icon-btn nav-toggle"
            aria-expanded="false"
            aria-controls="header-nav"
            aria-label="メニューを開く"
          >
            <span class="bar"></span>
          </button>
        </div>
      </div>
    </header>
    <noscript class="nav-fallback">
      <style>
        .nav-toggle { display: none !important; }
        .header-nav { display: flex !important; position: static !important; box-shadow: none !important; }
      </style>
    </noscript>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© 2026 {SHOSHI_SITE_NAME}</p>
    </footer>
    <script is:inline src="/nav.js" defer></script>
    <script is:inline src="/toc.js" defer></script>
  </body>
</html>
