---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** true なら検索エンジンにインデックスさせない（非公開ページ用） */
  noindex?: boolean;
  /** false ならAdSense審査・広告コードを読み込まない（検索など操作専用ページ用） */
  adsense?: boolean;
  /** OGP のタイプ。トップ・一覧は website、記事は article */
  ogType?: "website" | "article";
  /** OGP画像（サイトルート基準のパス）。省略時はデフォルト画像 */
  image?: string;
  /** 構造化データ（JSON-LD）。単一オブジェクトまたは配列 */
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description = "法律を体系的に学べるオンライン学習サイト。基礎から応用まで、1トピック1ページで解説します。",
  noindex = false,
  adsense = true,
  ogType = "website",
  image = "/ogp-default.png",
  jsonLd,
} = Astro.props;
const fullTitle = title === "トピカ" ? "トピカ｜法律学習サイト" : `${title}｜トピカ`;

// canonical / OGP 用の絶対URL。site 未設定でもフォールバックで壊れないようにする。
const site = Astro.site ?? new URL("https://topica-law.com");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;

const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Cloudflare Web Analytics のトークン。Cloudflare ダッシュボード
// （Analytics & Logs → Web Analytics）でサイトを追加して発行されるトークンを貼る。
// 空のままならビーコンは出力しない（ビルドは壊れない）。
const CF_ANALYTICS_TOKEN = "c7cd2df2924841e28234f03cdd033f9e";

// Google AdSense のサイト運営者ID（審査用コードの client パラメータ）。
// 空にすればスニペットは出力されない。
const ADSENSE_CLIENT = "ca-pub-7356455610185406";

// Google Search Console 所有権確認（HTMLタグ方式）。
// public/googlec8f8a152e88811da.html（ファイル方式）は Cloudflare Pages が
// .html を拡張子なしURLへ308リダイレクトしてしまい検証不可のため、
// 同じトークンをHTMLタグ方式として埋め込んで確認する。
const GOOGLE_SITE_VERIFICATION = "c8f8a152e88811da";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // ダークモードの先行適用（FOUC防止）＋ JS有効判定。
      // 必ずCSS適用前（<head>の先頭）で同期実行する。
      document.documentElement.classList.add("has-js");
      (function () {
        try {
          var stored = localStorage.getItem("topica:theme");
          var theme =
            stored === "dark" || stored === "light"
              ? stored
              : window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          /* localStorage/matchMedia不可時はCSSのprefers-color-scheme頼りにする */
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="トピカ｜新着・更新" href="/rss.xml" />
    <title>{fullTitle}</title>

    {/* OGP (Open Graph) */}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="トピカ" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* 構造化データ (JSON-LD) */}
    {
      jsonLdList.map((obj) => (
        <script type="application/ld+json" set:html={JSON.stringify(obj)} />
      ))
    }
    {
      ADSENSE_CLIENT && adsense && !noindex && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
          crossorigin="anonymous"
        />
      )
    }
    {
      CF_ANALYTICS_TOKEN && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
        />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a href="/" class="site-logo">トピカ<span>法律学習サイト</span></a>
        <div class="header-right">
          <nav class="header-nav" id="header-nav">
            <div class="nav-group nav-subjects">
              <a href="/minpo/">民法</a>
              <a href="/shoho/">商法</a>
              <a href="/minso/">民訴</a>
              <a href="/kenpo/">憲法</a>
              <a href="/keiho/">刑法</a>
              <a href="/keiso/">刑訴</a>
              <a href="/gyosei/">行政法</a>
            </div>
            <div class="nav-divider" aria-hidden="true"></div>
            <div class="nav-group nav-content">
              <a href="/hanrei/">判例</a>
              <a href="/column/">コラム</a>
              <a href="/yougo/">用語集</a>
              <a href="/search/">🔍検索</a>
            </div>
          </nav>
          <button
            id="theme-toggle"
            type="button"
            class="icon-btn theme-toggle"
            aria-label="ダークモードに切り替える"
          >
            🌙
          </button>
          <button
            id="nav-toggle"
            type="button"
            class="icon-btn nav-toggle"
            aria-expanded="false"
            aria-controls="header-nav"
            aria-label="メニューを開く"
          >
            <span class="bar"></span>
          </button>
        </div>
      </div>
    </header>
    <noscript class="nav-fallback">
      <style>
        /* JS無効時はハンバーガー・ドロワー化を完全に無効化し、折返し表示のまま見せる */
        .nav-toggle { display: none !important; }
        .header-nav { display: flex !important; position: static !important; box-shadow: none !important; }
      </style>
    </noscript>
    <main>
      <slot />
    </main>
    {adsense && !noindex && <div class="ad-slot" aria-hidden="true"></div>}
    <footer class="site-footer">
      <p>
        <a href="/about/">このサイトについて</a>
        <a href="/contact/">お問い合わせ</a>
        <a href="/disclaimer/">免責事項</a>
        <a href="/privacy/">プライバシーポリシー</a>
      </p>
      <p>© 2026 トピカ</p>
    </footer>
    <script is:inline src="/progress.js" defer></script>
    <script is:inline src="/nav.js" defer></script>
    <script is:inline src="/toc.js" defer></script>
  </body>
</html>
