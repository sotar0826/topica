---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "資格試験を目指す初学者のための体系的な法律学習サイト" } = Astro.props;
const fullTitle = title === "トピカ" ? "トピカ｜法律学習サイト" : `${title}｜トピカ`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a href="/" class="site-logo">トピカ<span>法律学習サイト</span></a>
        <nav class="header-nav">
          <a href="/minpo/">民法</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <!-- 広告枠（将来用） -->
    <div class="ad-slot"></div>
    <footer class="site-footer">
      <p>
        <a href="/about/">このサイトについて</a>
        <a href="/disclaimer/">免責事項</a>
        <a href="/privacy/">プライバシーポリシー</a>
      </p>
      <p>© 2026 トピカ</p>
    </footer>
  </body>
</html>
